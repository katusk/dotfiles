set autoindent " copy indent from current line when starting a new line
set ignorecase " ignore case of normal letters in a pattern

set wrap       " wrap long lines, displaying continues on the next line
set linebreak  " wrap at chars in 'breakat' only, not at any char
set tabstop=4  " to display the Horizontal Tab character

set number     " show line numbers
set showmode   " show current mode
set ruler      " show line, col number of cursor pos

